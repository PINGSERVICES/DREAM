		function setLanguage(lang) {
			localStorage.setItem('preferred_lang', lang);
			const t = translations[lang];
			if (!t) return;
			if (lang === 'ar') { document.documentElement.setAttribute('dir', 'rtl'); document.documentElement.setAttribute('lang', 'ar'); } else { document.documentElement.setAttribute('dir', 'ltr'); document.documentElement.setAttribute('lang', lang); }
			document.querySelectorAll('[data-i18n]').forEach(el => { const key = el.getAttribute('data-i18n'); if (t[key]) el.textContent = t[key]; });
		}
		window.addEventListener('DOMContentLoaded', () => setLanguage(localStorage.getItem('preferred_lang') || 'en'));
	</script>

